# Postgres connection string.
# Local dev (matches `docker compose up -d db`):
DATABASE_URL="postgres://postgres:postgres@localhost:5432/vintage"

# Postgres used by the Vitest integration suite. Falls back to DATABASE_URL.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/vintage_test"

# --- Optional source credentials -------------------------------------------------
# Banco Central de Chile (BCCh) statistical API.
# Register for free at https://si3.bcentral.cl/ and request an API user/password.
# If unset, the BCH source is skipped during ingestion.
BCCH_USER=""
BCCH_PASS=""

# --- API limits (optional) -------------------------------------------------------
# Public, no-auth API. Defaults: 5 req/min per IP, 100 req/day per IP,
# 20000 req/day globally. Raise them only if you provide your own infra.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY_IP=100
RATE_LIMIT_PER_DAY_GLOBAL=20000
# Salt used to hash client IPs before storing quota counters.
RATE_LIMIT_SALT=""

# --- Cron security ---------------------------------------------------------------
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` to cron routes.
# Set this to any random string in the Vercel project settings.
CRON_SECRET=""
